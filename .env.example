# =============================================================================
# BizWave Platform — Root Environment Configuration Example
# Copy to .env and replace all placeholder secrets before starting services.
# NEVER commit real credentials, API keys, or encryption keys to Git.
# =============================================================================

# Runtime & Regional Defaults
NODE_ENV=development
TZ=Africa/Nairobi
DEFAULT_CURRENCY=KES
DEFAULT_LANGUAGE=en

# PostgreSQL (Use non-superuser bizwave_app for runtime; bizwave_owner only for migrations)
POSTGRES_DB=bizwave
POSTGRES_ADMIN_USER=bizwave_owner
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_OWNER_PASSWORD
POSTGRES_APP_USER=bizwave_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
DATABASE_URL=postgresql://bizwave_app:REPLACE_WITH_STRONG_APP_PASSWORD@127.0.0.1:5432/bizwave

# Redis (BullMQ job queues, rate limits, cache)
REDIS_URL=redis://127.0.0.1:6379

# Backend NestJS API
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,https://app.bizwave.co.ke

# Cryptography & Token Secrets (generate 64-byte random hex via `openssl rand -hex 32`)
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
ENCRYPTION_MASTER_KEY=REPLACE_WITH_64_CHAR_HEX_AES256_KEY
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_64_CHAR_HEX_WEBHOOK_SECRET

# Python FastAPI Intelligence Service
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8001
INTELLIGENCE_HOST=127.0.0.1
INTELLIGENCE_PORT=8001

# Optional Provider Defaults (Tenants also store AES-256-GCM encrypted credentials per org)
# Africa's Talking (Kenya SMS / Voice / USSD)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=BIZWAVE
AT_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=

# Safaricom M-Pesa Daraja API (for live transaction sync & reconciliation)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=

# Optional Transactional Email (SMTP / Postmark / SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bizwave.co.ke

# MsingiAI Platform API (Kenyan Swahili Sauti TTS & ASR — https://platform.msingiai.com/docs)
# Keep strictly server-side; NEVER expose to browser code, URLs, or logs.
# Leave MSINGI_API_KEY empty to use zero-cost browser Web Speech fallback locally,
# OR set MSINGI_BASE_URL to a self-hosted open-weight msingiai/sauti-tts endpoint.
MSINGI_BASE_URL=https://api.msingiai.com
MSINGI_API_KEY=
MSINGI_DEFAULT_VOICE=female3
MSINGI_TIMEOUT_MS=45000
