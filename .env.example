# LOCAL DOCKER DEVELOPMENT ONLY — copy to .env. Never use these credentials in production.
# Production uses .env.production created by scripts/deploy-vps.sh; see deployment guide.
NODE_ENV=development
TZ=Africa/Nairobi
POSTGRES_DB=bizwave
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-local-postgres-admin-password
# After starting PostgreSQL, provision the development-only application role
# with infrastructure/postgres/init-roles.sql before starting the full stack.
DATABASE_URL=postgresql://bizwave_app:bizwave_app_dev_pw@postgres:5432/bizwave
REDIS_URL=redis://redis:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Development values only. Replace all secrets for any real deployment.
JWT_SECRET=bizwave-dev-jwt-secret-change-in-production-min-32-chars-2026
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_SIGNING_SECRET=bizwave-dev-webhook-secret-change-in-prod

# Temporarily allow these portal tools on all plans: predict_basic,
# predict_advanced, ai_assistant, connect_core. Role/tenant/branch checks and
# other quotas remain in force. Set true to re-enable plan feature restrictions.
PORTAL_FEATURE_GATING_ENABLED=false

# These optional voice settings do not activate outbound SMS/WhatsApp/voice/USSD.
# When the provider is not configured the browser may offer Web Speech fallback.
MSINGI_BASE_URL=https://api.msingiai.com
MSINGI_API_KEY=
MSINGI_DEFAULT_VOICE=female3
