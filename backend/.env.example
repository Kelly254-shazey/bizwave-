NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://bizwave_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/bizwave
REDIS_URL=redis://127.0.0.1:6379
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8001
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=14
APP_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_64_CHAR_HEX
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
MSINGI_BASE_URL=https://api.msingiai.com
MSINGI_API_KEY=
MSINGI_DEFAULT_VOICE=female3
# false opens the four preview features across plans, never RBAC/branch scope.
PORTAL_FEATURE_GATING_ENABLED=false
# Optional OpenAI-compatible narrative enhancement; keep credentials server-side.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
